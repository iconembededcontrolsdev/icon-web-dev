# Email Configuration (Required)
# Get these details from your email provider

# SMTP Server Settings
# For Gmail: smtp.gmail.com
# For Outlook: smtp-mail.outlook.com
# For custom SMTP: your-smtp-server.com
SMTP_HOST=smtp.gmail.com

# SMTP Port
# Usually 587 for TLS or 465 for SSL
SMTP_PORT=587

# Set to 'true' for port 465 (SSL), 'false' for port 587 (TLS)
SMTP_SECURE=false

# Your email account credentials
# For Gmail: Use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Email address that appears in the "From" field
# Can be the same as SMTP_USER
SMTP_FROM=your-email@gmail.com

# Email address where enquiries will be sent
# Can be the same as SMTP_USER or different
COMPANY_EMAIL=your-email@gmail.com

# Your company name (appears in customer confirmation emails)
COMPANY_NAME=Your Company Name

# ============================================
# HOW TO SET UP GMAIL:
# ============================================
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an "App Password" for "Mail"
# 4. Use that 16-character password as SMTP_PASSWORD
# 5. Use your Gmail address as SMTP_USER
#
# For other email providers, check their documentation
# for SMTP settings and app-specific passwords.
